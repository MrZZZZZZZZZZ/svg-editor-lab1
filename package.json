{
  "name": "svg-editor-lab1",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SVG command-line editor for Lab1 Phase 1",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsc -p tsconfig.json && node dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "check": "tsc -p tsconfig.json && node --test dist/tests/*.test.js"
  },
  "dependencies": { "@xmldom/xmldom": "^0.9.12" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
